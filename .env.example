# ================================================================
# UBS-LMIS — Environment Variable Reference
# ================================================================
# Copy this file to `.env` for local development.
# NEVER commit `.env` to source control.
# Production secrets live in the deployment platform's secret store.
# ================================================================

# ── Database ─────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ubs_lmis
DATABASE_USERNAME=ubs_lmis_app
DATABASE_PASSWORD=local_dev_password_change_in_prod

# Full JDBC URL (alternative to individual fields above)
# DATABASE_URL=jdbc:postgresql://localhost:5432/ubs_lmis

# ── JWT ──────────────────────────────────────────────────────────
# Minimum 256-bit (32-char) secret for HS256.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_in_production

# Access token TTL (minutes). Keep short.
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15

# Refresh token TTL (days). Stored server-side (hashed); revocable.
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Mail (SMTP) ──────────────────────────────────────────────────
# Local dev: point to MailHog (see docker-compose.yml)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ubs-lmis.example
MAIL_TLS_ENABLED=false

# ── SMS Provider ─────────────────────────────────────────────────
# Adapter selection: HUBTEL | ARKESEL | TWILIO | STUB (local dev)
SMS_PROVIDER=STUB

# Hubtel (Ghana-local — recommended for production)
SMS_HUBTEL_CLIENT_ID=
SMS_HUBTEL_CLIENT_SECRET=
SMS_HUBTEL_SENDER_ID=UBS-LMIS

# Arkesel (alternative Ghana provider)
SMS_ARKESEL_API_KEY=
SMS_ARKESEL_SENDER_ID=UBS-LMIS

# Twilio (international fallback)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=

# ── Document / Photo Storage ─────────────────────────────────────
# FILESYSTEM or S3 (MinIO locally)
DOCUMENT_STORAGE_TYPE=FILESYSTEM
DOCUMENT_STORAGE_BASE_PATH=/data/ubs-lmis/documents

# S3-compatible (MinIO locally)
# DOCUMENT_STORAGE_TYPE=S3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=ubs-lmis-documents
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ── Application ──────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# School name used in notifications and report card headers
SCHOOL_NAME=University Basic School
SCHOOL_SHORT_NAME=UBS
SCHOOL_LOCATION=Legon, Accra, Ghana
